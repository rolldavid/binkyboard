// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  name         String
  users        User[]       @relation(name: "users")
  owner        User         @relation(fields: [ownerId], references: [id], name: "owner")
  ownerId      String
  posts        Post[]       @relation(name: "postlist")
  pinnedPost   Post?        @relation(fields: [pinnedPostId], references: [id], name: "pinned")
  pinnedPostId Int?         @unique
  allowList    String?
  privacy      PrivacyLevel @default(ONE)
  registry     String?
  headerUrl    String       @default("")
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  note      String
  slugs     String[]
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade, name: "postlist")
  boardId   String
  pinnedOn  Board?   @relation(name: "pinned")
}

model User {
  id          String  @id @default(cuid())
  name        String?
  email       String? @unique
  image       String?
  posts       Post[]
  boards      Board[] @relation(name: "users")
  ownedBoards Board[] @relation(name: "owner")
  role        String  @default("USER")
}

enum PrivacyLevel {
  ONE
  TWO
  THREE
}
