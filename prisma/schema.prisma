// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id                    String                 @id @default(cuid())
  createdAt             DateTime               @default(now())
  name                  String
  users                 User[]                 @relation(name: "users")
  owner                 User                   @relation(fields: [ownerId], references: [id], name: "owner")
  ownerId               String
  posts                 Post[]                 @relation(name: "postlist")
  pinnedPost            Post?                  @relation(fields: [pinnedPostId], references: [id], name: "pinned")
  pinnedPostId          Int?                   @unique
  collaborators         String?
  allowList             String?
  blocklist             String?
  privacy               PrivacyLevel           @default(ONE)
  registry              String?
  wallpaper             String                 @default("default")
  headerUrl             String                 @default("")
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
  bookmarkedBy          BookmarksByUser[]
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  note      String
  slugs     String[]
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade, name: "postlist")
  boardId   String
  pinnedOn  Board?   @relation(name: "pinned")
}

model User {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String?                @unique
  image                 String?
  posts                 Post[]
  boards                Board[]                @relation(name: "users")
  ownedBoards           Board[]                @relation(name: "owner")
  boardOrder            String[]
  role                  String                 @default("USER")
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
  bookmarks             BookmarksByUser[]
  disableNotifications  String[]               @default([""])
  status                String?                @default("ACTIVE")
}

model Notification {
  id                    Int                    @id @default(autoincrement())
  createdAt             DateTime               @default(now())
  message               String
  description           String
  notificationsActive   NotificationActive[]
  notificationsComplete NotificationComplete[]
}

model NotificationActive {
  id             String       @id @default(cuid())
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId Int
  receivers      User[]
  sender         String
  board          Board?       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId        String?
}

model NotificationComplete {
  id             String       @id
  createdAt      DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId Int
  receivers      User[]
  sender         String
  board          Board?       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId        String?
}

model BookmarksByUser {
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId    String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  assignedAt DateTime @default(now())

  @@id([boardId, userId])
}

enum PrivacyLevel {
  ONE
  TWO
  THREE
}
